# ────────────────────────────────────────────────
# gramCarbon — Environment Variables
# Copy this file to .env.local and fill in values
# ────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gramcarbon?retryWrites=true&w=majority

# ── WhatsApp Business Cloud API ──────────────────
ACCESS_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_phone_number_id
VERIFY_TOKEN=your_webhook_verify_token

# ── JWT Authentication ────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_random_64_char_secret
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_secret

# ── Application ───────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AWS S3 (optional — for cloud file storage) ───
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=gramcarbon-files

# ── Logging ───────────────────────────────────────
LOG_LEVEL=info
# LOG_FILE=logs/app.log   # Uncomment to enable file logging
