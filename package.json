{
  "name": "ze-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:business-contacts": "tsx --env-file=.env.local scripts/seed-business-contacts.ts",
    "backup-db": "tsx --env-file=.env.local scripts/backup-db.ts",
    "wipe-db": "tsx --env-file=.env.local scripts/wipe-db.ts",
    "import:carbon-csv": "tsx --env-file=.env.local scripts/import-carbon-csv.ts",
    "update:offset-formula": "tsx --env-file=.env.local scripts/update-offset-formula.ts",
    "reset-password": "tsx --env-file=.env.local scripts/reset-password.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1061.0",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "mongoose": "^8.3.4",
    "next": "^16.2.7",
    "node-cron": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "sharp": "^0.35.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.0",
    "typescript": "6.0.3"
  }
}
